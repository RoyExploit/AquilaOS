# Local provider config -- contains API keys / base URLs / model choices.
# config.yaml.example is the safe template that IS committed.
config.yaml
config.yaml.bak
# Remembered window/splitter/zoom state (per machine -- not shared).
ui_state.json
.env
.env.*
*.env

# User data: run history database + everything the agents generate.
agentos_memory.sqlite3
*.sqlite3
workspace/

